<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.xxd.coroutine">

    <application
        android:name="com.xxd.common.base.BaseApplication"
        android:allowBackup="true"
        android:icon="@mipmap/coroutine_ic_launcher"
        android:label="@string/coroutine_app_name"
        android:roundIcon="@mipmap/coroutine_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/common_AppTheme"
        tools:ignore="LockedOrientationActivity">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".exception.ExceptionCoroutineActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".cancel.CancelCoroutineActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".lifecycle.LifecycleActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".lifecycle.LifecycleSwitchActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>


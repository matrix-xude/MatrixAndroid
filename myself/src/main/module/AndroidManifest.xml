<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


<!--    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>-->

    <queries>
        <package android:name="com.xxd.service"/>
    </queries>

    <application
        android:name="com.xxd.common.base.BaseApplication"
        android:allowBackup="true"
        android:icon="@mipmap/myself_ic_launcher"
        android:label="@string/myself_app_name"
        android:roundIcon="@mipmap/myself_ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/myself_AppTheme"
        tools:ignore="LockedOrientationActivity">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".task.activity.FirstActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".task.activity.SecondActivity"
            android:launchMode="singleTask"
            android:screenOrientation="portrait" />
        <activity
            android:name=".task.activity.ThirdActivity"
            android:screenOrientation="portrait"
            android:taskAffinity="com.xxd.myself2" />
        <activity
            android:name=".flow.FlowActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".dp.DpActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".touchevent.TouchEventActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".handler.HandlerActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".navigation.NavigationActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".service.ServiceActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".room.RoomActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>
